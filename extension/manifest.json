{
  "manifest_version": 3,
  "name": "Himalayas Hiring Assistant",
  "version": "0.1.5",
  "description": "Review candidates, draft outreach, and manage recruiting conversations.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "key": ""
}
